# Sur Toolforge : toolforge envvars create NOM  (la valeur est demandée, jamais affichée)
DRF_ADMIN_TOKEN=un-long-jeton-aleatoire        # protège le tableau de bord
DRF_SECRET=une-autre-chaine-aleatoire          # signe les cookies de session
DRF_ACCOUNT=OviXBot
# Authentification du compte (au choix) :
DRF_BOT_USER=VotreCompte@OviXBot               # mot de passe de robot : Spécial:BotPasswords (droits : modifier les pages existantes, limites élevées)
DRF_BOT_PASSWORD=...
# DRF_OAUTH_TOKEN=...                          # ou jeton OAuth 2.0 « owner-only »
