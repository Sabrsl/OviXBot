# Configuration OviXBot
DRF_ADMIN_TOKEN=local
DRF_SECRET=local-dev
DRF_INSECURE_COOKIES=1
DRF_EMBED_WORKER=1
DRF_DATA_DIR=./data

# Désactive le rafraîchissement automatique des infos bot (threads daemon) - utile en cas de blocage uWSGI
# Le tableau de bord affichera alors les informations en cache sans mettre à jour automatiquement
# DRF_DISABLE_BOT_REFRESH=1

# Credentials Wikipédia (mot de passe de robot : Spécial:MotsDePasseDeRobot, droit « Modifier les pages existantes »)
DRF_ACCOUNT=OviXBot
DRF_BOT_USER=OviXBot@OviX
DRF_BOT_PASSWORD=
# DRF_OAUTH_TOKEN=votre_jeton_oauth