<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net481 pour production AWB -->
    <TargetFramework>net481</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DeadLinkFix.Awb</RootNamespace>
    <AssemblyName>DeadLinkFix.Awb</AssemblyName>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="WikiFunctions">
      <HintPath>..\..\..\..\WikiFunctions.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\..\..\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="DeadLinkFix.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
